rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();

      match /habits/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /subjects/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /schedules/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /exams/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /resources/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /pomodoros/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /leaderboards/{weekId}/scores/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isAdmin();
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
          || request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == 'pending'
        && request.resource.data.fromUid != request.resource.data.toUid
        && (!('participants' in request.resource.data)
          || (request.resource.data.participants is list
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.toUid in request.resource.data.participants));
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && (!('participants' in resource.data)
          || request.resource.data.participants == resource.data.participants);
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.auth.uid in request.resource.data.members;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.members;
    }

    match /polytechnicCatalog/{catalogId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
